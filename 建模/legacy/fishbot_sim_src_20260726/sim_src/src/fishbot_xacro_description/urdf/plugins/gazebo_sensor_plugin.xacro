<?xml version="1.0"?>
<!-- Gazebo Sim 单颗三维激光雷达，以及用于调试的二维原始扫描。 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="gazebo_lidar_plugin"
               params="link_name laser_height">
    <gazebo reference="${link_name}">
      <!-- /scan_raw 只用于验证投影结果，导航不会直接使用它。 -->
      <sensor name="scan_raw" type="gpu_lidar">
        <pose>0 0 ${laser_height} 0 0 0</pose>
        <topic>scan_raw</topic>
        <!-- 确保 ros_gz_bridge 转发后的 LaserScan frame 正确。 -->
        <gz_frame_id>${link_name}</gz_frame_id>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>

      <!--
        单颗三维 GPU 激光雷达。Gazebo 在存在 vertical scan 时发布
        gz.msgs.PointCloudPacked，ros_gz_bridge 将其转成 PointCloud2。
      -->
      <sensor name="lidar_points" type="gpu_lidar">
        <pose>0 0 ${laser_height} 0 0 0</pose>
        <topic>lidar/points</topic>
        <gz_frame_id>${link_name}</gz_frame_id>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.12</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
