<?xml version="1.0"?>
<!-- 通过 gz_ros2_control 把 Gazebo 的轮关节交给 ros2_control 管理。 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="gazebo_control_plugin"
               params="prefix wheel_radius
                       front_left_joint rear_left_joint
                       front_right_joint rear_right_joint
                       controllers_file">
    <!-- command_interface 是控制器写入的目标，state_interface 是 Gazebo 返回的状态。 -->
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <joint name="${front_left_joint}">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${rear_left_joint}">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${front_right_joint}">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${rear_right_joint}">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <gazebo>
      <!-- 该插件内部启动 controller_manager，并读取控制器配置。 -->
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${controllers_file}</parameters>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
