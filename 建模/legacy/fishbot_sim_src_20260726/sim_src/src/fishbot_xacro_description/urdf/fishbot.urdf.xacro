<?xml version="1.0"?>
<!--
  Xacro 会先展开变量和宏，再生成标准 URDF。
  使用 robot_name 作为 link 前缀，避免多个机器人同时出现时 TF 重名。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fishbot_xacro">
  <!-- 插件定义放在 plugins/，这里负责把插件挂到当前机器人上。 -->
  <xacro:include filename="plugins/gazebo_control_plugin.xacro"/>
  <xacro:include filename="plugins/gazebo_sensor_plugin.xacro"/>

  <xacro:arg name="robot_name" default="fishbot"/>
  <xacro:arg name="controllers_file" default="$(find fishbot_xacro_description)/config/controllers.yaml"/>
  <!-- prefix 是后续所有 frame 名称的统一前缀。 -->
  <xacro:property name="prefix" value="$(arg robot_name)"/>

  <!-- 集中管理可调尺寸；修改这些参数即可整体改变机器人。 -->
  <xacro:property name="base_length" value="0.64"/>
  <xacro:property name="base_width" value="0.42"/>
  <xacro:property name="base_height" value="0.20"/>
  <xacro:property name="base_mass" value="5.0"/>
  <!-- 四轮直径为 0.20 m；轮心高度与半径相同，轮底正好落在 z=0。 -->
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.06"/>
  <xacro:property name="wheel_mass" value="0.4"/>
  <!-- 前后轮沿 X 方向的中心距位置。 -->
  <xacro:property name="wheel_x_offset" value="${base_length / 2.0 - wheel_radius}"/>
  <!-- 左右轮中心到机器人中心线的距离，轮内侧与底盘侧面对齐。 -->
  <xacro:property name="wheel_y_offset" value="${base_width / 2.0 + wheel_width / 2.0}"/>
  <xacro:property name="laser_radius" value="0.07"/>
  <xacro:property name="laser_height" value="0.05"/>

  <material name="blue">
    <color rgba="0.1 0.3 0.9 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>
  <material name="gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <!-- 可复用的惯量宏，避免每个部件重复手写惯量公式。 -->
  <xacro:macro name="box_inertia" params="mass x y z">
    <inertia ixx="${mass * (y * y + z * z) / 12.0}"
             ixy="0.0" ixz="0.0"
             iyy="${mass * (x * x + z * z) / 12.0}"
             iyz="0.0"
             izz="${mass * (x * x + y * y) / 12.0}"/>
  </xacro:macro>

  <!-- 圆柱默认沿局部 Z 轴；轮子通过 rpy 旋转到 Y 轴。 -->
  <xacro:macro name="cylinder_inertia" params="mass radius length">
    <inertia ixx="${mass * (3 * radius * radius + length * length) / 12.0}"
             ixy="0.0" ixz="0.0"
             iyy="${mass * (3 * radius * radius + length * length) / 12.0}"
             iyz="0.0"
             izz="${mass * radius * radius / 2.0}"/>
  </xacro:macro>

  <!--
    一个宏生成任意位置的轮子。
    position 用 front/rear 区分前后，side 用 left/right 区分左右。
  -->
  <xacro:macro name="wheel" params="position side x y">
    <link name="${prefix}_${position}_${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <mass value="${wheel_mass}"/>
        <xacro:cylinder_inertia mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
      </inertial>
    </link>
    <joint name="${prefix}_${position}_${side}_wheel_joint" type="continuous">
      <parent link="${prefix}_base_link"/>
      <child link="${prefix}_${position}_${side}_wheel_link"/>
      <!-- x/y 由调用者给出；轮心高度等于半径，刚好接触地面。 -->
      <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- 底盘是机器人树的根 link。 -->
  <link name="${prefix}_base_link">
    <visual>
      <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <xacro:box_inertia mass="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
    </inertial>
  </link>

  <!-- 调用同一个轮子宏四次，消除四个轮子的重复代码。 -->
  <xacro:wheel position="front" side="left"  x="${wheel_x_offset}"  y="${wheel_y_offset}"/>
  <xacro:wheel position="front" side="right" x="${wheel_x_offset}"  y="${-wheel_y_offset}"/>
  <xacro:wheel position="rear"  side="left"  x="${-wheel_x_offset}" y="${wheel_y_offset}"/>
  <xacro:wheel position="rear"  side="right" x="${-wheel_x_offset}" y="${-wheel_y_offset}"/>

  <!-- 顶部雷达固定在底盘上，导航时它会在 Gazebo 中发布 /scan。 -->
  <link name="${prefix}_laser_link">
    <visual>
      <origin xyz="0 0 ${laser_height / 2.0}" rpy="0 0 0"/>
      <geometry><cylinder radius="${laser_radius}" length="${laser_height}"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${laser_height / 2.0}" rpy="0 0 0"/>
      <geometry><cylinder radius="${laser_radius}" length="${laser_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <xacro:cylinder_inertia mass="0.25" radius="${laser_radius}" length="${laser_height}"/>
    </inertial>
  </link>
  <joint name="${prefix}_laser_joint" type="fixed">
    <parent link="${prefix}_base_link"/>
    <child link="${prefix}_laser_link"/>
    <!-- 雷达底部与底盘顶部接触，因此关节高度使用 base_height。 -->
    <origin xyz="0.12 0 ${base_height}" rpy="0 0 0"/>
  </joint>

  <!-- 通过宏挂载底盘控制插件。定义在 plugins/gazebo_control_plugin.xacro。 -->
  <xacro:gazebo_control_plugin
    prefix="${prefix}"
    wheel_radius="${wheel_radius}"
    front_left_joint="${prefix}_front_left_wheel_joint"
    rear_left_joint="${prefix}_rear_left_wheel_joint"
    front_right_joint="${prefix}_front_right_wheel_joint"
    rear_right_joint="${prefix}_rear_right_wheel_joint"
    controllers_file="$(arg controllers_file)"/>

  <!-- 通过宏挂载 2D 激光雷达插件。定义在 plugins/gazebo_sensor_plugin.xacro。 -->
  <xacro:gazebo_lidar_plugin
    link_name="${prefix}_laser_link"
    laser_height="${laser_height}"/>
</robot>
