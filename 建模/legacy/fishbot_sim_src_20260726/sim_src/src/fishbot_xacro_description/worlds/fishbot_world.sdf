<?xml version="1.0" ?>
<!--
  SDF 世界文件描述“机器人所在的环境”，而 URDF/Xacro 描述“机器人自身”。
  本文件定义重力、光照和一块有碰撞与摩擦的地面。
-->
<sdf version="1.9">
  <world name="fishbot_world">
    <!-- 世界坐标系使用 Z 轴向上；重力单位是 m/s^2。 -->
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- 物理步长越小通常越稳定，但会消耗更多计算资源。 -->
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- 场景的背景、环境光和阴影。 -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- 平行光模拟太阳。 -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!--
      static=true 表示地面不会被重力推动。
      plane 的 normal 决定法向；0 0 1 表示地面朝上，位于世界 z=0。
      size 是可视网格的长和宽，单位为米。
    -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <!-- 摩擦系数越大，轮子越不容易打滑。 -->
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <!-- pose 的格式是 x y z roll pitch yaw；这里 z=0.35 表示 0.7 m 高墙的中心高度。 -->
      <pose>0 4 0.35 0 0 0</pose>
      <link name="link">
        <!-- 每面墙都同时有 collision 和 visual：前者用于碰撞，后者用于显示。 -->
        <collision name="collision"><geometry><box><size>8 0.12 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8 0.12 0.7</size></box></geometry><material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 0.12 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8 0.12 0.7</size></box></geometry><material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>4 0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 8 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 8 0.7</size></box></geometry><material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-4 0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 8 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 8 0.7</size></box></geometry><material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="center_obstacle">
      <static>true</static>
      <!-- 中间障碍物用于测试激光雷达、代价地图和导航避障。 -->
      <pose>1.2 0.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7 1.8 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 1.8 0.7</size></box></geometry><material><ambient>0.45 0.35 0.2 1</ambient><diffuse>0.45 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="side_obstacle">
      <static>true</static>
      <!-- yaw=0.35 让障碍物斜放，方便观察建图和局部规划是否能处理非正交障碍。 -->
      <pose>-1.7 1.5 0.35 0 0 0.35</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.6 0.5 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.6 0.5 0.7</size></box></geometry><material><ambient>0.25 0.42 0.42 1</ambient><diffuse>0.25 0.42 0.42 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
