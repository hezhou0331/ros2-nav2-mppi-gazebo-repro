<?xml version="1.0"?>
<package format="3">
  <name>fishbot_xacro_description</name>
  <version>0.0.1</version>
  <description>Xacro learning package for a reusable differential-drive robot model.</description>
  <maintainer email="student@example.com">student</maintainer>
  <license>Apache-2.0</license>

  <!-- 构建工具；CMakeLists.txt 通过它完成安装。 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 启动文件根据包名查找 install/share 目录。 -->
  <exec_depend>ament_index_python</exec_depend>
  <!-- 提供关节滑块，便于在 RViz 中观察连续和转动关节。 -->
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <!-- 根据 URDF 发布各 link 间的 TF 坐标变换。 -->
  <exec_depend>robot_state_publisher</exec_depend>
  <!-- 可视化机器人模型。 -->
  <exec_depend>rviz2</exec_depend>
  <!-- 把本包的 .xacro 处理为标准 URDF。 -->
  <exec_depend>xacro</exec_depend>
  <!-- 启动 Gazebo Sim 世界，并将机器人生成到该世界中。 -->
  <exec_depend>ros_gz_sim</exec_depend>
  <!-- 在 ROS 2 和 Gazebo Sim 之间转发 /cmd_vel、/odom、/scan 等话题。 -->
  <exec_depend>ros_gz_bridge</exec_depend>
  <!-- 运行导航、规划、控制和行为树节点。 -->
  <exec_depend>nav2_bringup</exec_depend>
  <!-- Nav2 的 SLAM 模式会用它根据激光雷达建图。 -->
  <exec_depend>slam_toolbox</exec_depend>
  <!-- 学习阶段用键盘发布 /cmd_vel 手动遥控小车。 -->
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
